{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "env": {
    "CLOUDINARY_CLOUD_NAME": "dejq2wekc",
    "CLOUDINARY_API_KEY": "265985862821867",
    "CLOUDINARY_API_SECRET": "5BGnSnWbnSwlqX3I8fPCXC0aRC8"
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/temni_fon_chata.png",
